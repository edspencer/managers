{
  "name": "managers",
  "version": "0.1.0",
  "private": true,
  "description": "Managers: scheduled per-project manager agents that track long-running objectives. A fork of Paddock, built on herdctl.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build -w packages/server && npm run build -w packages/web",
    "build:server": "npm run build -w packages/server",
    "build:web": "npm run build -w packages/web",
    "pack:npm": "npm run build && node scripts/make-npm-package.mjs",
    "dev": "npm run dev -w packages/server",
    "dev:web": "npm run dev -w packages/web",
    "typecheck": "npm run typecheck -w packages/server && npm run typecheck -w packages/web",
    "check:nul": "node scripts/check-no-nul-bytes.mjs",
    "start": "npm run start -w packages/server",
    "test": "npm run test -w packages/server && npm run test -w packages/web",
    "test:server": "npm run test -w packages/server",
    "test:web": "npm run test -w packages/web",
    "test:e2e": "playwright test -c test/e2e/playwright.config.ts",
    "test:e2e:live": "MANAGERS_TEST_LIVE=1 playwright test -c test/e2e/playwright.config.ts",
    "version:print": "node -p \"require('./packages/server/package.json').version\"",
    "demo:gif": "node scripts/demo-gif/make.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "playwright": "^1.61.0"
  }
}
